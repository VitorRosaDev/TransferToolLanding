# ---------------------------------------------------------------------------
# TransferTool Landing Page — variaveis de ambiente (build)
# Copie este arquivo para `.env.local` (nao versionado) e preencha os valores.
# ---------------------------------------------------------------------------

# Measurement ID do Google Analytics 4.
# Enquanto estiver vazio, NENHUM script de terceiros e carregado pela pagina.
VITE_GA_ID=

# Mude para "true" quando os instaladores estiverem publicados no repositorio
# publico de releases. Com "false" os cards exibem o estado "em preparacao".
VITE_RELEASES_READY=false

# URL da pagina de releases (usada no QR Code do APK e como fallback dos cards).
VITE_RELEASES_PAGE_URL=https://github.com/VitorRosaDev/TransferToolReleases/releases

# URLs diretas dos assets (formato: .../releases/download/<tag>/<arquivo>)
VITE_DESKTOP_DOWNLOAD_URL=https://github.com/VitorRosaDev/TransferToolReleases/releases/download/v1.1.0/TransferToolRPA-Setup-1.1.0.exe
VITE_MOBILE_DOWNLOAD_URL=https://github.com/VitorRosaDev/TransferToolReleases/releases/download/v1.1.1/TransferTool-1.1.1.apk
